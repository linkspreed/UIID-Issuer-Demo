# Copy this file to ".env" and fill in your values.
# Never commit ".env" — it contains your secret API key.

# API key of your UIID Issuer account (Company, Collective or Government account).
# Paste the key only: no "Bearer " prefix, no quotes, no spaces.
# The key must come from the same UIID instance as UIID_BASE_URL.
UIID_ISSUER_KEY=

# Base URL of the UIID provider. Change only if you use another UIID instance.
UIID_BASE_URL=https://uiid.linkspreed.com

# Which client to use:
#   auto -> official SDK from vendor/ if present, otherwise the built-in REST client
#   sdk  -> official SDK only (fails if vendor/uiid-issuer-sdk.js is missing)
#   rest -> built-in REST client only
UIID_CLIENT=auto

# Where the demo server listens. Keep 127.0.0.1 unless you know what you are doing:
# anyone who can reach this server can issue UIIDs under your Issuer ID.
HOST=127.0.0.1
PORT=3000
